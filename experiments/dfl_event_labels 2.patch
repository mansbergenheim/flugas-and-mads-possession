diff --git a/mtah/loaders/dfl_events.py b/mtah/loaders/dfl_events.py
new file mode 100644
index 0000000..f18abeb
--- /dev/null
+++ b/mtah/loaders/dfl_events.py
@@ -0,0 +1,213 @@
+"""Rebuild DFL possession labels from the logged events, using the tracking to fix their timing.
+
+DFL's own BallPossession flag flips on touches and runs late. The competition says possession changes
+only when the other team gains control, and the event files say which actions show that: passes,
+shots, interceptions and tackles marked as changing possession. Clearances and tackles that change
+nothing don't count.
+
+Logged event times are only roughly right, and in some matches the whole event clock is about 2 s
+off. So each match's offset is measured first, then each event is moved to the moment the tracking
+shows that player reaching the ball. Stoppages still come from DFL's BallStatus flag.
+"""
+
+import datetime
+import re
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Tuple
+
+import numpy as np
+
+from .. import metrics as m
+from ..match import A, D, H, Match, X
+
+SEARCH_S = 1.5        # how far from its corrected time an event may be moved
+CLOCK_SEARCH_S = 6.0  # how far to look when measuring a match's clock offset
+CONTACT_M = 2.0       # the player counts as on the ball within this distance, if nearer than any rival
+WRAPPERS = ("KickOff", "FreeKick", "ThrowIn", "CornerKick", "GoalKick", "Penalty")
+TEAM_ACTIONS = ("Play", "ShotAtGoal", "BallClaiming", "Run")
+
+
+@dataclass(frozen=True)
+class Touch:
+    time: float    # seconds, epoch
+    team: str
+    player: Optional[str]
+
+
+def _seconds(text: str) -> float:
+    return datetime.datetime.fromisoformat(text).timestamp()
+
+
+def _control(element) -> Optional[Tuple[str, Optional[str]]]:
+    """(team, player) if this action shows a team in control of the ball, else None."""
+    tag = element.tag
+    if tag in WRAPPERS:
+        for child in element:
+            found = _control(child)
+            if found:
+                return found
+        return None
+    if tag in TEAM_ACTIONS and element.get("Team"):
+        return element.get("Team"), element.get("Player")
+    if tag == "OtherBallAction" and element.get("Team") and element.get("DefensiveClearance") != "true":
+        return element.get("Team"), element.get("Player")
+    if tag == "TacklingGame" and element.get("PossessionChange") == "true":
+        return element.get("WinnerTeam"), element.get("Winner")
+    return None
+
+
+def read_touches(events_path: str) -> List[Touch]:
+    touches = []
+    for event in ET.parse(events_path).getroot().iter("Event"):
+        for action in event:
+            found = _control(action)
+            if found and found[0]:
+                touches.append(Touch(_seconds(event.get("EventTime")), found[0], found[1]))
+                break
+    return sorted(touches, key=lambda t: t.time)
+
+
+def read_clock(positions_path: str, teams) -> Tuple[Dict, List]:
+    """{section: (first frame number, its time)} for the ball, and [(person, team)] sorted as in load_dfl."""
+    clock, people = {}, set()
+    pending = None
+    head = re.compile(r'GameSection="(\w+)".*TeamId="([^"]+)" PersonId="([^"]+)"')
+    frame = re.compile(r'<Frame N="(\d+)" T="([^"]+)"')
+    with open(positions_path) as handle:
+        for line in handle:
+            if "<FrameSet" in line:
+                section, team, person = head.search(line).groups()
+                if team == "BALL":
+                    pending = section
+                elif team in teams:
+                    people.add((person, team))
+            elif pending and "<Frame " in line:
+                n, t = frame.search(line).groups()
+                clock[pending] = (int(n), _seconds(t))
+                pending = None
+    return clock, sorted(people)
+
+
+def _team_distance(match: Match) -> Dict[int, np.ndarray]:
+    """Each team's nearest player to the ball on every frame."""
+    delta = match.players - match.ball[:, None, :]
+    dist = np.hypot(delta[..., 0], delta[..., 1])
+    dist = np.where(np.isfinite(dist), dist, np.inf)
+    return {side: dist[:, match.team == side].min(1) for side in (0, 1)}
+
+
+def _touching(distance: np.ndarray, rival: np.ndarray) -> np.ndarray:
+    """This player is close to the ball and nearer to it than any opponent, so a defender pressing
+    the player on the ball doesn't start a possession early."""
+    return (distance <= CONTACT_M) & (distance <= rival)
+
+
+def _nearest_hit(frame: int, touching: np.ndarray, search: int) -> Optional[int]:
+    lo, hi = max(frame - search, 0), min(frame + search + 1, len(touching))
+    hits = lo + np.flatnonzero(touching[lo:hi])
+    return int(hits[np.abs(hits - frame).argmin()]) if len(hits) else None
+
+
+def snap(frame: int, touching: np.ndarray, search: int) -> Tuple[int, bool]:
+    """First frame of the contact nearest the given frame, and whether contact was found."""
+    t = _nearest_hit(frame, touching, search)
+    if t is None:
+        return frame, False
+    while t > 0 and touching[t - 1]:
+        t -= 1
+    return t, True
+
+
+def verified(labels: np.ndarray, marks: List[Tuple[int, int]], fps: int, limit_s: float = 4.0,
+             margin_s: float = 1.0) -> np.ndarray:
+    """Keep DFL's timing, but fold short spells between two spells of the other team when no logged
+    control by that team falls inside them."""
+    out = labels.copy()
+    runs = m.valid_runs(out)
+    frames = np.array([f for f, _ in marks])
+    codes = np.array([c for _, c in marks])
+    margin = int(margin_s * fps)
+    while True:
+        segs = m.segments(out, runs)
+        todo = []
+        for i in range(1, len(segs) - 1):
+            a, b, k = segs[i]
+            before, after = segs[i - 1], segs[i + 1]
+            other = A if k == H else H
+            if k in (H, A) and b - a < limit_s * fps and before[2] == after[2] == other \
+                    and before[1] == a and after[0] == b:
+                if not ((codes == k) & (frames >= a - margin) & (frames < b + margin)).any():
+                    todo.append((b - a, a, b, other))
+        if not todo:
+            return out
+        todo.sort()
+        touched = -1
+        for _, a, b, other in todo:
+            if a > touched:
+                out[a:b] = other
+                touched = b
+
+
+def event_labels(match: Match, events_path: str, positions_path: str, home_id: str, away_id: str,
+                 report: Optional[Dict] = None, only_marks: bool = False):
+    """H/A/D/X per frame. Keeps every D and X in match.labels and replaces only H and A."""
+    clock, people = read_clock(positions_path, (home_id, away_id))
+    slot = {p: i for i, (p, _) in enumerate(people)}
+    nearest = _team_distance(match)
+    sections = ("firstHalf", "secondHalf")
+    fps, search = match.fps, int(SEARCH_S * match.fps)
+
+    placed = []  # (frame, team code, player slot or None)
+    touches = read_touches(events_path)
+    for touch in touches:
+        for section, (lo, hi) in zip(sections, match.halves):
+            frame = lo + int(round((touch.time - clock[section][1]) * fps))
+            if lo <= frame < hi:
+                placed.append((frame, H if touch.team == home_id else A, slot.get(touch.player), lo))
+                break
+
+    contact: Dict[Tuple[int, int], np.ndarray] = {}
+
+    def touching(player: int, code: int) -> np.ndarray:
+        if (player, code) not in contact:
+            delta = match.players[:, player] - match.ball
+            contact[player, code] = _touching(np.hypot(delta[:, 0], delta[:, 1]), nearest[1 if code == H else 0])
+        return contact[player, code]
+
+    wide = int(CLOCK_SEARCH_S * fps)
+    gaps = [hit - frame for frame, code, player, _ in placed if player is not None
+            for hit in [_nearest_hit(frame, touching(player, code), wide)] if hit is not None]
+    offset = int(np.median(gaps)) if gaps else 0
+
+    marks = []  # (frame, team code)
+    moved = []
+    for frame, code, player, lo in placed:
+        frame += offset
+        if player is not None:
+            snapped, ok = snap(frame, touching(player, code), search)
+            if ok:
+                moved.append(snapped - frame)
+            frame = max(snapped, lo)
+        marks.append((frame, code))
+    marks.sort()
+    if only_marks:
+        return marks
+
+    out = match.labels.copy()
+    alive = (out == H) | (out == A)
+    edges = np.diff(np.concatenate(([0], alive.astype(np.int8), [0])))
+    frames = np.array([m[0] for m in marks])
+    codes = np.array([m[1] for m in marks])
+    for a, b in zip(np.flatnonzero(edges == 1), np.flatnonzero(edges == -1)):
+        inside = (frames >= a) & (frames < b)
+        if not inside.any():
+            continue  # no logged control in this stretch: keep DFL's own flag
+        f, c = frames[inside], codes[inside]
+        bounds = np.concatenate(([a], f[1:], [b]))
+        out[a:b] = np.repeat(c, np.diff(bounds))
+    if report is not None:
+        report.update(touches=len(touches), placed=len(marks), snapped=len(moved),
+                      clock_offset_s=offset / fps,
+                      median_shift_s=float(np.median(moved) / fps) if moved else 0.0)
+    return out
